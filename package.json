{
  "name": "fanalamanga_procurement_ui",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "icon": "node scripts/generate-icon.cjs",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.0.0",
    "@eslint/js": "^9.22.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@react-pdf/renderer": "^4.3.0",
    "@tailwindcss/vite": "^4.1.4",
    "@tanstack/react-query": "^5.74.3",
    "@tanstack/react-query-devtools": "^5.74.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.1.2",
    "@types/yup": "^0.32.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.12.0",
    "antd": "^5.24.7",
    "apexcharts": "^5.6.0",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.13",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "html5-qrcode": "^2.3.8",
    "jimp": "^1.6.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.494.0",
    "png-to-ico": "^3.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-apexcharts": "^1.7.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.5.0",
    "react-toastify": "^11.0.5",
    "socket.io-client": "^4.8.3",
    "tailwind-clip-path": "^1.0.0",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.4",
    "tw-animate-css": "^1.2.5",
    "typed.js": "^2.1.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.0",
    "wait-on": "^9.5.1",
    "xlsx": "^0.18.5",
    "yup": "^1.6.1"
  },
  "build": {
    "appId": "sa.fanalamanga.procurement",
    "productName": "Fanalamanga SA Approvisionnement",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "config.json",
        "to": "config.json"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "fiderana19",
        "repo": "FanalamangaSAApproExe",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fanalamanga SA Approvisionnement",
      "artifactName": "Fanalamanga-SA-Approvisionnement-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
